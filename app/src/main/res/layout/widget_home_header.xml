<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:src="@drawable/ic_brand"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tagline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/tagline" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/avatar" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_avatar" android:clickable="true" android:focusable="true" android:gravity="center" android:text="HC" android:textColor="#195D47" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
