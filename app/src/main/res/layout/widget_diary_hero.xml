<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_diary_hero" android:clipToOutline="true" android:gravity="center_vertical" android:minHeight="145dp" android:orientation="horizontal" android:padding="24dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="HÔM NAY" android:textColor="#B8FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:id="@+id/hero_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold"/>
        <TextView android:id="@+id/hero_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#B8FFFFFF" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="68dp" android:layout_height="68dp" android:layout_marginStart="10dp" android:background="@drawable/bg_hero_circle" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/hero_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="mục" android:textColor="#B3FFFFFF" android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
