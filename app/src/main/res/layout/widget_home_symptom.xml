<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_heart_card" android:clickable="true" android:clipToOutline="true" android:focusable="true" android:minHeight="170dp" android:padding="22dp">
    <ImageView android:layout_width="150dp" android:layout_height="50dp" android:layout_gravity="bottom|end" android:layout_marginBottom="14dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/ic_pulse"/>
    <FrameLayout android:layout_width="59dp" android:layout_height="59dp" android:layout_gravity="top|end" android:background="@drawable/bg_bubble">
        <ImageView android:layout_width="27dp" android:layout_height="27dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_heart" android:tint="#FFFFFF"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="80dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="THEO DÕI TRIỆU CHỨNG" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="bottom" android:orientation="horizontal">
            <TextView android:id="@+id/symptom_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="6dp" android:text="lần / 7 ngày" android:textColor="#BFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/symptom_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#D1FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/symptom_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_pill_light" android:paddingStart="13dp" android:paddingTop="8dp" android:paddingEnd="13dp" android:paddingBottom="8dp" android:text="Xem chi tiết  →" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
