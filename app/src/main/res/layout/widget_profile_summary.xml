<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:background="@drawable/card" android:gravity="center_horizontal" android:orientation="vertical">
    <TextView android:id="@+id/ps_avatar" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_avatar_large" android:gravity="center" android:textColor="#1C604A" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:id="@+id/ps_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:id="@+id/ps_tagline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/tagline" android:textColor="#7D8982" android:textSize="12sp"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/divider"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:weightSum="2">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/ps_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ngày theo dõi" android:textColor="#7C8881" android:textSize="11sp"/>
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/divider"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/ps_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ngày liên tiếp" android:textColor="#7C8881" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
