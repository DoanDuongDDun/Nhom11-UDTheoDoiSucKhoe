<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/card" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/card_kicker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:textColor="#87929B" android:textSize="10sp" android:textStyle="bold" android:visibility="gone"/>
            <TextView android:id="@+id/card_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/card_action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_green" android:clickable="true" android:focusable="true" android:paddingStart="11dp" android:paddingTop="7dp" android:paddingEnd="11dp" android:paddingBottom="7dp" android:textColor="#44705F" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/card_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical"/>
</LinearLayout>
