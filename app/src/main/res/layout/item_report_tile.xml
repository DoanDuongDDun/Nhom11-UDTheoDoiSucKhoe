<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_tile" android:minHeight="140dp" android:orientation="vertical" android:padding="15dp">
    <FrameLayout android:id="@+id/rt_icon_box" android:layout_width="36dp" android:layout_height="36dp">
        <ImageView android:id="@+id/rt_icon" android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView android:id="@+id/rt_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#718078" android:textSize="12sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="bottom" android:orientation="horizontal">
        <TextView android:id="@+id/rt_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rt_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:textColor="#7E8A83" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/rt_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_pill_badge" android:paddingStart="7dp" android:paddingTop="4dp" android:paddingEnd="7dp" android:paddingBottom="4dp" android:textColor="#25805E" android:textSize="11sp" android:textStyle="bold"/>
</LinearLayout>
