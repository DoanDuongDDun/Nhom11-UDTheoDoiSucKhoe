<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:background="@drawable/bg_category_bar" android:orientation="horizontal" android:padding="5dp" android:weightSum="5">
    <LinearLayout android:id="@+id/cat_overview" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:background="@drawable/bg_chip_active" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_grid" app:tint="#172133"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tổng quan" android:textColor="#172133" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/cat_activity" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1"  android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_shoe" app:tint="#718091"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Vận động" android:textColor="#718091" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/cat_sleep" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1"  android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_moon" app:tint="#718091"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Giấc ngủ" android:textColor="#718091" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/cat_nutrition" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1"  android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_fork" app:tint="#718091"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Dinh dưỡng" android:textColor="#718091" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/cat_period" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:contentDescription="Chu kỳ kinh nguyệt" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_heart" app:tint="#718091"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Kỳ kinh" android:textColor="#718091" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
