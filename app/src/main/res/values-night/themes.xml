<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Vitality" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorSecondaryContainer">@color/nav_indicator</item>
        <item name="colorOnSecondaryContainer">@color/nav_active</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.Vitality.Button</item>
        <item name="textInputStyle">@style/Widget.Vitality.TextInput</item>
    </style>
    <style name="Theme.Vitality" parent="Base.Theme.Vitality"/>
    <!-- Nút phụ: nền trắng mờ, viền trắng, bo tròn -->
    <style name="Widget.Vitality.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">#D9FFFFFF</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">#FFFFFF</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Vitality.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#B8FFFFFF</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="Widget.Vitality.Tab" parent="">
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">#78857E</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

